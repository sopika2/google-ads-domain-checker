{
  "name": "google-ads-domain-check",
  "version": "0.1.0",
  "description": "Check any list of domains for live Google Ads via the Ads Transparency Center: advertiser, ad count, last seen, days active, formats, and new/ended ads between runs. HTTP-only, pay per event.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:regions": "node scripts/generate-regions.mjs"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "got-scraping": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "i18n-iso-countries": "^7.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "author": "sae@niijimasisters.com",
  "license": "MIT"
}
